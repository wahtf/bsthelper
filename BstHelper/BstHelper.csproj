<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>BstHelper</AssemblyName>
    <RootNamespace>BstHelper</RootNamespace>
    <Version>0.1.5.0</Version>
    <Author>Wah</Author>
    <Name>BstHelper</Name>
    <Punchline>Master's Bestiary at a glance, and a ride to whatever is still missing.</Punchline>
    <Description>Master's Bestiary at a glance, and a ride to whatever is still missing.</Description>
    <RepoUrl>https://github.com/wahtf/bsthelper</RepoUrl>
    <Tags>beastmaster;bst;bestiary;travel</Tags>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS8600</NoWarn>
  </PropertyGroup>
</Project>
